# Copy to .env and fill in. Keep .env private: don't commit it, don't share it.
# The server compares what the keeper types at sign-in against these; they are
# never sent to a browser.
ANTFARM_USER=
ANTFARM_PASSWORD=

# Optional
# ANTFARM_SESSION_HOURS=72      # how long a sign-in lasts
# ANTFARM_FRAME_HZ=10           # updates per second sent to watchers
# ANTFARM_MAX_VIEWERS=200       # watchers at once
# ANTFARM_SAVE_SECONDS=60       # how often the house farm is saved
